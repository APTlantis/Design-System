<!-- ========================================================================
     PHASE C — LOGOS & THEMING PIPELINE EXPLAINER
     Composed directly from 6 live Aptlantis Gallery components:
     08 Feature Spotlight · 01 Process Stepper · 04 Before/After Comparison
     02 Explanation Panel · 06 OKLCH Explorer · 03 Diagram Inspector
     07 Artifact Gallery
     ======================================================================== -->

<div class="apt-specimen-nav">
  <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
    <a href="/components" class="apt-btn" data-variant="ghost">← Component Gallery</a>
    <span class="apt-badge" data-tone="amber">PHASE C · EXHIBITION DEMO</span>
  </div>
  <nav style="display:flex; gap:0.35rem; flex-wrap:wrap;" aria-label="Explainer chapters">
    <a href="#chapter-stages" class="apt-pill-btn" style="text-decoration:none;">01 Pipeline</a>
    <a href="#chapter-compare" class="apt-pill-btn" style="text-decoration:none;">02 Before/After</a>
    <a href="#chapter-depth" class="apt-pill-btn" style="text-decoration:none;">03 Depth &amp; OKLCH</a>
    <a href="#chapter-system" class="apt-pill-btn" style="text-decoration:none;">04 Architecture</a>
    <a href="#chapter-artifacts" class="apt-pill-btn" style="text-decoration:none;">05 Artifacts</a>
  </nav>
</div>

<!-- HERO: Component 08 (Feature Spotlight) -->
<section class="apt-spotlight" aria-label="Logos and Theming Pipeline overview">
  <div class="apt-spotlight-copy">
    <span class="apt-gallery-eyebrow">APTLANTIS EXHIBITION · LOGOS &amp; THEMING PIPELINE</span>
    <h3>From Source Emblem to Calibrated Multi-Facet Design System</h3>
    <p>
      How a handful of vector emblems become a coherent, OKLCH-calibrated visual language
      spanning HTML interfaces, Mermaid diagrams, syntax themes, data visualizations, and
      downloadable artifacts—without relying on a heavyweight frontend framework.
    </p>
    <ul class="apt-spotlight-list">
      <li><strong>Step through</strong> all four pipeline stages from artwork ingestion to live HTML.</li>
      <li><strong>Compare</strong> raw hex styling against semantic OKLCH tokens interactively.</li>
      <li><strong>Inspect &amp; download</strong> real SVG, CSS, JSON, and TOML outputs at the end.</li>
    </ul>
    <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
      <a href="#chapter-stages" class="apt-btn" data-variant="primary">Start the Walkthrough ↓</a>
      <button type="button" class="apt-btn" data-variant="ghost" data-apt-spotlight-toggle aria-pressed="true">
        Disable Bioluminescent Glow
      </button>
    </div>
  </div>

  <div class="apt-spotlight-visual" data-glow="on">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <span class="apt-mono" style="font-size:0.7rem; color:var(--apt-brand-primary-hover);">PIPELINE TELEMETRY</span>
      <span class="apt-badge" data-tone="cyan">6 LIVE COMPONENTS COMPOSED</span>
    </div>

    <svg viewBox="0 0 340 165" style="width:100%; height:auto;" aria-hidden="true">
      <defs>
        <linearGradient id="exp-hero-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00CAE3" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#F7BE4F" stop-opacity="0.2"/>
        </linearGradient>
      </defs>
      <rect x="8" y="8" width="324" height="149" rx="10" fill="#031C28" stroke="#07455E"/>
      <!-- Emblem -->
      <circle cx="68" cy="82" r="38" fill="url(#exp-hero-grad)" stroke="#23F2F7" stroke-width="1.5"/>
      <polygon points="68,54 90,66 85,98 68,108 51,98 46,66" fill="#05303F" stroke="#F7BE4F" stroke-width="1.5"/>
      <circle cx="68" cy="81" r="6" fill="#23F2F7"/>
      <!-- Flow arrows -->
      <path d="M114 82 L140 82" stroke="#00CAE3" stroke-width="2" stroke-dasharray="3 3"/>
      <!-- OKLCH ramp -->
      <rect x="146" y="42" width="16" height="80" rx="3" fill="#00101A" stroke="#07455E"/>
      <rect x="166" y="42" width="16" height="80" rx="3" fill="#0380A1"/>
      <rect x="186" y="42" width="16" height="80" rx="3" fill="#23F2F7"/>
      <rect x="206" y="42" width="16" height="80" rx="3" fill="#F7BE4F"/>
      <!-- Output facets -->
      <path d="M228 82 L248 82" stroke="#F7BE4F" stroke-width="2" stroke-dasharray="3 3"/>
      <rect x="254" y="34" width="64" height="22" rx="4" fill="#05303F" stroke="#00CAE3"/>
      <text x="268" y="49" fill="#FDFDFB" font-family="JetBrains Mono, monospace" font-size="9">HTML</text>
      <rect x="254" y="64" width="64" height="22" rx="4" fill="#05303F" stroke="#F7BE4F"/>
      <text x="263" y="79" fill="#FDFDFB" font-family="JetBrains Mono, monospace" font-size="9">MERMAID</text>
      <rect x="254" y="94" width="64" height="22" rx="4" fill="#05303F" stroke="#18AAC2"/>
      <text x="267" y="109" fill="#FDFDFB" font-family="JetBrains Mono, monospace" font-size="9">TOKENS</text>
      <rect x="254" y="124" width="64" height="22" rx="4" fill="#05303F" stroke="#A29062"/>
      <text x="272" y="139" fill="#FDFDFB" font-family="JetBrains Mono, monospace" font-size="9">SVG</text>
    </svg>

    <div class="apt-mono" style="display:flex; justify-content:space-between; font-size:0.7rem; color:var(--apt-text-muted);">
      <span>1. Emblem</span>
      <span>2. OKLCH (32)</span>
      <span>3. Semantic Map</span>
      <span>4. Multi-Facet</span>
    </div>
  </div>
</section>

<!-- CHAPTER 1: Component 01 (Interactive Process Stepper) -->
<section id="chapter-stages" class="apt-panel">
  <div class="apt-panel-head">
    <h2 class="apt-panel-title">01 · Walk the Four-Stage Pipeline</h2>
    <span class="apt-mono" style="font-size:0.72rem; color:var(--apt-text-muted);">Component 01 · Interactive Process Stepper</span>
  </div>

  <div class="apt-stage">
    <div class="apt-stepper" data-apt-stepper>
      <div class="apt-stepper-track" role="tablist" aria-label="Logos and Theming Pipeline stages">
        <% stages.each_with_index do |stage, i| %>
          <button type="button"
                  class="apt-step-trigger"
                  role="tab"
                  data-step-index="<%= stage.index %>"
                  aria-selected="<%= i == 0 %>"
                  tabindex="<%= i == 0 ? 0 : -1 %>"
                  hx-get="/components/process-stepper/stage/<%= stage.index %>"
                  hx-target="#explainer-stepper-panel"
                  hx-swap="innerHTML">
            <span class="apt-step-code"><%= stage.code %></span>
            <span class="apt-step-label"><%= stage.title %></span>
          </button>
        <% end %>
      </div>

      <div id="explainer-stepper-panel">
        <%= render_partial("_stepper_stage", stage: stages.first) %>
      </div>

      <div class="apt-stepper-footer">
        <div style="display:flex; gap:0.5rem;">
          <button type="button" class="apt-btn" data-step-prev>← Previous</button>
          <button type="button" class="apt-btn" data-variant="primary" data-step-next>Next Stage →</button>
        </div>
        <div class="apt-stepper-progress" aria-hidden="true">
          <div class="apt-stepper-progress-fill" data-step-progress style="width:25%;"></div>
        </div>
        <span class="apt-mono" data-step-counter style="font-size:0.75rem; color:var(--apt-text-secondary);">STAGE 01 / 04</span>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER 2: Component 04 (Before/After Comparison) -->
<section id="chapter-compare" class="apt-panel">
  <div class="apt-panel-head">
    <h2 class="apt-panel-title">02 · Why Calibration Matters — Before &amp; After</h2>
    <span class="apt-mono" style="font-size:0.72rem; color:var(--apt-text-muted);">Component 04 · Before/After Comparison</span>
  </div>

  <div class="apt-stage">
    <div class="apt-compare-wrap" data-apt-compare>
      <div class="apt-compare-toolbar">
        <div class="apt-pill-group" role="group" aria-label="Comparison presets">
          <button type="button" class="apt-pill-btn" data-compare-preset="100" aria-pressed="false">Before (Generic)</button>
          <button type="button" class="apt-pill-btn" data-compare-preset="50" aria-pressed="true">Split 50 / 50</button>
          <button type="button" class="apt-pill-btn" data-compare-preset="0" aria-pressed="false">After (Aptlantis)</button>
        </div>
        <span class="apt-mono" style="font-size:0.75rem; color:var(--apt-text-secondary);">
          DIVIDER: <strong data-compare-readout style="color:var(--apt-brand-primary-hover);">50%</strong>
        </span>
      </div>

      <div class="apt-compare" style="--split: 50%;">
        <span class="apt-compare-tag" data-side="before">BEFORE · UNCALIBRATED DARK</span>
        <span class="apt-compare-tag" data-side="after">AFTER · APTLANTIS OKLCH TOKENS</span>

        <div class="apt-compare-layer apt-compare-before">
          <div class="apt-mock-card apt-mock-card--raw">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <strong style="font-size:1.05rem; color:#e2e8f0;">Pipeline Output · Website Facet</strong>
              <span style="font-size:0.72rem; padding:2px 8px; border-radius:999px; background:#334155; color:#cbd5e1;">RAW HEX</span>
            </div>
            <p style="margin:0; font-size:0.84rem; color:#94a3b8;">
              Ad-hoc grays and generic blue accents lose the Aptlantis identity and drift quickly across pages.
            </p>
            <div style="display:flex; gap:0.5rem;">
              <span style="padding:0.4rem 0.8rem; border-radius:6px; background:#3b82f6; color:#fff; font-size:0.8rem;">Inspect Tokens</span>
              <span style="padding:0.4rem 0.8rem; border-radius:6px; border:1px solid #475569; color:#cbd5e1; font-size:0.8rem;">Download</span>
            </div>
          </div>
        </div>

        <div class="apt-compare-layer apt-compare-after">
          <div class="apt-mock-card apt-mock-card--apt">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <strong class="apt-display" style="font-size:1.08rem; color:var(--apt-text-primary);">Pipeline Output · Website Facet</strong>
              <span class="apt-badge" data-tone="cyan">OKLCH CALIBRATED</span>
            </div>
            <p style="margin:0; font-size:0.84rem; color:var(--apt-text-secondary);">
              Deep oceanic surfaces, Space Grotesk + JetBrains Mono hierarchy, and semantic cyan/amber contrast derived directly from brand geometry.
            </p>
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <span class="apt-btn" data-variant="primary" style="pointer-events:none;">Inspect Tokens</span>
              <span class="apt-btn" data-variant="ghost" style="pointer-events:none;">Download</span>
              <span class="apt-mono" style="margin-left:auto; font-size:0.72rem; color:var(--apt-brand-secondary);">32 TOKENS</span>
            </div>
          </div>
        </div>

        <div class="apt-compare-divider" aria-hidden="true">
          <div class="apt-compare-handle">↔</div>
        </div>

        <input type="range" class="apt-compare-range" min="0" max="100" value="50" aria-label="Compare generic dark styling before and Aptlantis calibrated tokens after" />
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER 3: Component 02 (Expandable Explanation Panel) + Component 06 (OKLCH Explorer) -->
<section id="chapter-depth" class="apt-panel" style="display:grid; gap:1rem;">
  <div class="apt-panel-head" style="margin-bottom:0;">
    <h2 class="apt-panel-title">03 · Explore Technical Depth &amp; Tune OKLCH Live</h2>
    <span class="apt-mono" style="font-size:0.72rem; color:var(--apt-text-muted);">Components 02 &amp; 06 · Progressive Depth + OKLCH Explorer</span>
  </div>

  <div class="apt-explain" data-apt-explain>
    <div class="apt-explain-head">
      <div class="apt-explain-meta">
        <span class="apt-mono" style="font-size:0.74rem; color:var(--apt-brand-primary-hover);">CHOOSE DEPTH</span>
        <strong class="apt-display" style="font-size:0.95rem;">How Primitives Become Semantic Tokens</strong>
      </div>

      <div class="apt-pill-group" role="tablist" aria-label="Choose explanation depth">
        <% depths.each_with_index do |depth, i| %>
          <button type="button"
                  class="apt-pill-btn"
                  role="tab"
                  data-depth-key="<%= depth.key %>"
                  aria-selected="<%= i == 0 %>"
                  tabindex="<%= i == 0 ? 0 : -1 %>"
                  hx-get="/components/explanation-panel/depth/<%= depth.key %>"
                  hx-target="#explainer-depth-body"
                  hx-swap="innerHTML">
            <%= depth.label %>
          </button>
        <% end %>
      </div>
    </div>

    <div id="explainer-depth-body">
      <%= render_partial("_explanation_depth", depth: depths.first) %>
    </div>
  </div>

  <div class="apt-oklch" data-apt-oklch>
    <div class="apt-oklch-controls">
      <div class="apt-slider-row">
        <div class="apt-slider-head">
          <label for="exp-ok-l">Lightness (L)</label>
          <strong data-oklch-l-out style="color:var(--apt-brand-primary-hover);">0.77</strong>
        </div>
        <input id="exp-ok-l" class="apt-range" type="range" min="0.12" max="0.96" step="0.01" value="0.77" data-oklch-l />
      </div>

      <div class="apt-slider-row">
        <div class="apt-slider-head">
          <label for="exp-ok-c">Chroma (C)</label>
          <strong data-oklch-c-out style="color:var(--apt-brand-primary-hover);">0.145</strong>
        </div>
        <input id="exp-ok-c" class="apt-range" type="range" min="0.000" max="0.260" step="0.005" value="0.145" data-oklch-c />
      </div>

      <div class="apt-slider-row">
        <div class="apt-slider-head">
          <label for="exp-ok-h">Hue Angle (H)</label>
          <strong data-oklch-h-out style="color:var(--apt-brand-primary-hover);">204°</strong>
        </div>
        <input id="exp-ok-h" class="apt-range" type="range" min="0" max="360" step="1" value="204" data-oklch-h />
      </div>

      <div class="apt-role-grid" role="listbox" aria-label="Aptlantis semantic roles">
        <% roles.each_with_index do |role, i| %>
          <button type="button"
                  class="apt-role-chip"
                  data-oklch-role="<%= role.key %>"
                  data-l="<%= role.l %>"
                  data-c="<%= role.c %>"
                  data-h="<%= role.h %>"
                  aria-selected="<%= i == 0 %>"
                  hx-get="/components/oklch-explorer/role/<%= role.key %>"
                  hx-target="#explainer-oklch-role"
                  hx-swap="innerHTML">
            <span class="apt-role-dot" style="background:<%= role.hex_ref %>;"></span>
            <span style="display:grid;">
              <strong style="font-size:0.78rem;"><%= role.label %></strong>
              <span class="apt-mono" style="font-size:0.66rem; color:var(--apt-text-muted);"><%= role.hex_ref %></span>
            </span>
          </button>
        <% end %>
      </div>
    </div>

    <div style="display:grid; gap:0.85rem; align-content:start;">
      <div class="apt-oklch-preview">
        <div class="apt-oklch-swatch">
          <span id="exp-oklch-css" class="apt-oklch-swatch-tag" data-oklch-css>oklch(0.77 0.145 204)</span>
          <button type="button" class="apt-btn" data-apt-copy="#exp-oklch-css">Copy OKLCH</button>
        </div>
        <p style="margin:0; font-size:0.82rem; color:var(--apt-text-secondary);">
          Click any Aptlantis semantic role to snap the sliders, or sweep Hue to explore oceanic-to-solar balance.
        </p>
      </div>
      <div id="explainer-oklch-role">
        <%= render_partial("_oklch_role", role: roles.first) %>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER 4: Component 03 (Interactive Diagram Inspector) -->
<section id="chapter-system" class="apt-panel">
  <div class="apt-panel-head">
    <h2 class="apt-panel-title">04 · Inspect How Workspace Layers Connect</h2>
    <span class="apt-mono" style="font-size:0.72rem; color:var(--apt-text-muted);">Component 03 · Interactive Diagram Inspector</span>
  </div>

  <div class="apt-stage">
    <div class="apt-diagram" data-apt-diagram>
      <div class="apt-diagram-canvas">
        <svg class="apt-diagram-svg" viewBox="0 0 560 300" role="group" aria-label="Aptlantis Pipeline Architecture">
          <defs>
            <marker id="exp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="#00CAE3"/>
            </marker>
          </defs>

          <path d="M 190 78 L 245 78" stroke="#00637D" stroke-width="2" marker-end="url(#exp-arrow)"/>
          <path d="M 110 116 L 110 184 L 245 215" fill="none" stroke="#00637D" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#exp-arrow)"/>
          <path d="M 330 116 L 330 176" stroke="#00CAE3" stroke-width="2" marker-end="url(#exp-arrow)"/>

          <g class="apt-diagram-node" role="button" tabindex="0" data-diagram-node="foundation" aria-selected="true"
             hx-get="/components/diagram-inspector/node/foundation" hx-target="#explainer-diagram-panel" hx-swap="innerHTML">
            <rect x="20" y="40" width="170" height="76" rx="8"/>
            <text x="34" y="64" fill="#F7BE4F" font-family="JetBrains Mono, monospace" font-size="10">DF-01 · TOKENS</text>
            <text x="34" y="86" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700">Design Foundation</text>
            <text x="34" y="103" fill="#A0B4B9" font-family="Inter, sans-serif" font-size="10">OKLCH · Fonts · Icons</text>
          </g>

          <g class="apt-diagram-node" role="button" tabindex="0" data-diagram-node="components" aria-selected="false"
             hx-get="/components/diagram-inspector/node/components" hx-target="#explainer-diagram-panel" hx-swap="innerHTML">
            <rect x="250" y="40" width="165" height="76" rx="8"/>
            <text x="264" y="64" fill="#23F2F7" font-family="JetBrains Mono, monospace" font-size="10">CL-02 · SPECIMENS</text>
            <text x="264" y="86" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700">Component Library</text>
            <text x="264" y="103" fill="#A0B4B9" font-family="Inter, sans-serif" font-size="10">12 Live HTML Pieces</text>
          </g>

          <g class="apt-diagram-node" role="button" tabindex="0" data-diagram-node="behavior" aria-selected="false"
             hx-get="/components/diagram-inspector/node/behavior" hx-target="#explainer-diagram-panel" hx-swap="innerHTML">
            <rect x="20" y="182" width="170" height="76" rx="8"/>
            <text x="34" y="206" fill="#23F2F7" font-family="JetBrains Mono, monospace" font-size="10">BL-03 · BEHAVIOR</text>
            <text x="34" y="228" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700">Behavior &amp; HTMX</text>
            <text x="34" y="245" fill="#A0B4B9" font-family="Inter, sans-serif" font-size="10">JS + Kemal Fragments</text>
          </g>

          <g class="apt-diagram-node" role="button" tabindex="0" data-diagram-node="explainer" aria-selected="false"
             hx-get="/components/diagram-inspector/node/explainer" hx-target="#explainer-diagram-panel" hx-swap="innerHTML">
            <rect x="250" y="182" width="165" height="76" rx="8"/>
            <text x="264" y="206" fill="#F7BE4F" font-family="JetBrains Mono, monospace" font-size="10">EX-04 · EXHIBITION</text>
            <text x="264" y="228" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="700">Explainer Platform</text>
            <text x="264" y="245" fill="#A0B4B9" font-family="Inter, sans-serif" font-size="10">This Page in Action</text>
          </g>
        </svg>
      </div>

      <div id="explainer-diagram-panel">
        <%= render_partial("_diagram_node", node: diagram_nodes.first) %>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER 5: Component 07 (Artifact Gallery) -->
<section id="chapter-artifacts" class="apt-panel">
  <div class="apt-panel-head">
    <h2 class="apt-panel-title">05 · Inspect &amp; Download Pipeline Artifacts</h2>
    <span class="apt-mono" style="font-size:0.72rem; color:var(--apt-text-muted);">Component 07 · Artifact Gallery</span>
  </div>

  <div class="apt-stage" data-apt-artifacts style="display:grid; gap:1rem;">
    <div class="apt-pill-group" role="group" aria-label="Filter pipeline artifacts" style="justify-self:start;">
      <button type="button" class="apt-pill-btn" data-artifact-filter="ALL" aria-pressed="true">All (<%= artifacts.size %>)</button>
      <button type="button" class="apt-pill-btn" data-artifact-filter="Logos" aria-pressed="false">Logos</button>
      <button type="button" class="apt-pill-btn" data-artifact-filter="Icons" aria-pressed="false">Icons</button>
      <button type="button" class="apt-pill-btn" data-artifact-filter="Tokens" aria-pressed="false">Tokens</button>
      <button type="button" class="apt-pill-btn" data-artifact-filter="Diagrams" aria-pressed="false">Diagrams</button>
    </div>

    <div class="apt-artifact-layout">
      <div class="apt-artifact-grid">
        <% artifacts.each_with_index do |item, i| %>
          <article class="apt-artifact-card"
                   data-artifact-card
                   data-artifact-category="<%= item.category %>"
                   data-selected="<%= i == 0 %>"
                   hx-get="/components/artifact-gallery/item/<%= item.id %>"
                   hx-target="#explainer-artifact-detail"
                   hx-swap="innerHTML"
                   style="cursor:pointer;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:0.4rem;">
              <strong class="apt-display" style="font-size:0.88rem;"><%= item.name %></strong>
              <span class="apt-badge" data-tone="cyan"><%= item.format %></span>
            </div>
            <p style="margin:0; font-size:0.78rem; color:var(--apt-text-secondary);"><%= item.summary %></p>
            <div class="apt-mono" style="display:flex; justify-content:space-between; font-size:0.68rem; color:var(--apt-text-muted); margin-top:auto;">
              <span><%= item.category %></span>
              <span><%= item.size_label %></span>
            </div>
          </article>
        <% end %>
      </div>

      <div id="explainer-artifact-detail">
        <%= render_partial("_artifact_detail", artifact: artifacts.first) %>
      </div>
    </div>
  </div>
</section>
