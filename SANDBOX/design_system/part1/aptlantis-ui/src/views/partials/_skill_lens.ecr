        <text x="758" y="194" text-anchor="middle" fill="#23F2F7" font-family="JetBrains Mono, monospace" font-size="10">Mermaid Source &amp; Themes</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="visual" data-mmd-node="chartjs-charts" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/chartjs-charts" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="624" y="246" width="268" height="68" rx="6"/>
        <text x="758" y="276" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="15">chartjs-charts</text>
        <text x="758" y="296" text-anchor="middle" fill="#23F2F7" font-family="JetBrains Mono, monospace" font-size="10">Canvas Data Visualizations</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="doc" data-mmd-node="documentation-site-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/documentation-site-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="624" y="328" width="268" height="76" rx="6"/>
        <text x="758" y="362" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="15">documentation-site-engineer</text>
        <text x="758" y="384" text-anchor="middle" fill="#BC8F81" font-family="JetBrains Mono, monospace" font-size="10">Starlight · Docusaurus · MkDocs</text>
      </g>
    </svg>

  <% else %>
    <svg class="apt-mmd-svg" viewBox="0 0 920 390" fill="none" role="img" aria-label="Local Engineering, Data and Media Skills">
      <defs>
        <marker id="aptMmdArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 1 1.5 L 9 5 L 1 8.5 z" fill="#86A0A9"/>
        </marker>
        <marker id="aptMmdArrowActive" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 1 1.5 L 9 5 L 1 8.5 z" fill="#23F2F7"/>
        </marker>
      </defs>

      <!-- Orthogonal Connectors -->
      <path class="apt-mmd-edge" data-mmd-edge="repository-archaeologist,rust-tauri-app-architect" d="M 272 72 H 334" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="rust-tauri-app-architect,desktop-release-installer-engineer" d="M 588 72 H 646" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="powershell-automation-engineer,desktop-release-installer-engineer" d="M 272 178 H 614 V 96 H 646" stroke-dasharray="5 4" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="duckdb-sqlite-data-engineer,local-ai-retrieval-engineer" d="M 272 296 H 334" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="ffmpeg-media-engineer,imagemagick-imaging-engineer" d="M 772 246 V 270" stroke-dasharray="4 4" marker-end="url(#aptMmdArrow)"/>

      <!-- Row 1: Desktop App Delivery -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="repository-archaeologist" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/repository-archaeologist" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="20" y="28" width="252" height="86" rx="6"/>
        <text x="146" y="64" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="15">repository-archaeologist</text>
        <text x="146" y="88" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Read-Only Repo Recon</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="rust-tauri-app-architect" aria-selected="true"
         hx-get="/explainer/agent-skills/skill/rust-tauri-app-architect" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="336" y="28" width="252" height="86" rx="6"/>
        <text x="462" y="64" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="15">rust-tauri-app-architect</text>
        <text x="462" y="88" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Desktop Apps · IPC · State</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="desktop-release-installer-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/desktop-release-installer-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="648" y="28" width="252" height="86" rx="6"/>
        <text x="774" y="64" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14.5">desktop-release-installer</text>
        <text x="774" y="88" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Installers · Signing · SHA-256</text>
      </g>

      <!-- Row 2: Automation & Media -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="powershell-automation-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/powershell-automation-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="20" y="138" width="252" height="80" rx="6"/>
        <text x="146" y="172" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14.5">powershell-automation</text>
        <text x="146" y="194" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">PS7 Scripts &amp; Modules</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="ffmpeg-media-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/ffmpeg-media-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="648" y="162" width="252" height="82" rx="6"/>
        <text x="774" y="196" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="15">ffmpeg-media-engineer</text>
        <text x="774" y="218" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Audio / Video Pipelines</text>
      </g>

      <!-- Row 3: Data, RAG & Imaging -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="duckdb-sqlite-data-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/duckdb-sqlite-data-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="20" y="256" width="252" height="84" rx="6"/>
        <text x="146" y="290" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14.5">duckdb-sqlite-data-eng</text>
        <text x="146" y="312" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Local SQL · Schemas · Backups</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="local-ai-retrieval-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/local-ai-retrieval-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="336" y="256" width="252" height="84" rx="6"/>
        <text x="462" y="290" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14.5">local-ai-retrieval-eng</text>
        <text x="462" y="312" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">Ollama · Embeddings · RAG</text>
      </g>

      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="imagemagick-imaging-engineer" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/imagemagick-imaging-engineer" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="648" y="274" width="252" height="84" rx="6"/>
        <text x="774" y="308" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14.5">imagemagick-imaging-eng</text>
        <text x="774" y="330" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10">ImageMagick 7 · Palettes · Alpha</text>
      </g>
    </svg>
  <% end %>
</div>

<div id="skills-inspector-host">
  <%= render_partial("_skill_inspector", skill: default_skill) %>
</div>

<% if oob %>
  <pre id="skills-mmd-source" hx-swap-oob="true" class="apt-code-pre"><%= HTML.escape(lens.mermaid_source.strip) %></pre>
<% end %>
