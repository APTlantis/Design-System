<div class="apt-mmd-bar">
  <div style="display:flex; align-items:center; gap:0.6rem;">
    <span style="width:9px; height:9px; border-radius:50%; background:#23F2F7; display:inline-block;"></span>
    <strong class="apt-display" style="font-size:0.95rem;"><%= HTML.escape(lens.headline) %></strong>
  </div>
  <div class="apt-mmd-legend">
    <span style="color:#F7BE4F;"><span class="apt-mmd-legend-swatch" style="background:#14252D; border:1px solid #F7BE4F;"></span>govNode</span>
    <span style="color:#23F2F7;"><span class="apt-mmd-legend-swatch" style="background:#14252D; border:1px solid #23F2F7;"></span>visualNode</span>
    <span style="color:#00CAE3;"><span class="apt-mmd-legend-swatch" style="background:#14252D; border:1px solid #00CAE3;"></span>engNode</span>
    <span style="color:#BC8F81;"><span class="apt-mmd-legend-swatch" style="background:#1E2F38; border:1px solid #BC8F81;"></span>docNode</span>
  </div>
</div>

<div class="apt-mmd-stage" data-mmd-stage data-style-mode="classed">
  <% if lens.id == "ecosystem" %>
    <svg class="apt-mmd-svg" viewBox="0 0 920 390" fill="none" role="img" aria-label="Agent Skills Ecosystem Overview">
      <defs>
        <marker id="aptMmdArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 1 1.5 L 9 5 L 1 8.5 z" fill="#86A0A9"/>
        </marker>
        <marker id="aptMmdArrowActive" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 1 1.5 L 9 5 L 1 8.5 z" fill="#23F2F7"/>
        </marker>
      </defs>

      <!-- Orthogonal Connectors -->
      <path class="apt-mmd-edge" data-mmd-edge="skill-synthesis-engine,hub-city-hall" d="M 262 195 H 322 V 76 H 370" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="skill-synthesis-engine,hub-visual" d="M 262 195 H 322 V 195 H 370" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="skill-synthesis-engine,hub-engineering" d="M 262 195 H 322 V 314 H 370" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="hub-visual,hub-docs" d="M 610 195 H 674" marker-end="url(#aptMmdArrow)"/>
      <path class="apt-mmd-edge" data-mmd-edge="hub-city-hall,hub-engineering" d="M 490 124 V 142 M 610 76 H 644 V 314 H 614" stroke-dasharray="5 4" marker-end="url(#aptMmdArrow)"/>

      <!-- Edge Protocol Pills -->
      <rect x="284" y="122" width="76" height="20" rx="4" fill="#031C28" stroke="#07455E"/>
      <text x="322" y="135" text-anchor="middle" fill="#A0B4B9" font-family="JetBrains Mono, monospace" font-size="10">synthesize</text>
      <rect x="615" y="185" width="52" height="20" rx="4" fill="#031C28" stroke="#07455E"/>
      <text x="641" y="198" text-anchor="middle" fill="#A0B4B9" font-family="JetBrains Mono, monospace" font-size="10">assets</text>

      <!-- Meta Hub: skill-synthesis-engine -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="doc" data-mmd-node="skill-synthesis-engine" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/skill-synthesis-engine" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="22" y="145" width="240" height="100" rx="6"/>
        <text x="142" y="182" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="16">skill-synthesis-engine</text>
        <text x="142" y="204" text-anchor="middle" fill="#CFD0C9" font-family="Inter, sans-serif" font-size="12.5">Meta-Skill Authoring</text>
        <text x="142" y="226" text-anchor="middle" fill="#BC8F81" font-family="JetBrains Mono, monospace" font-size="10.5">class: docNode · 1 skill</text>
      </g>

      <!-- Hub 1: City Hall (ACTIVE) -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="gov" data-mmd-node="hub-city-hall" aria-selected="true"
         hx-get="/explainer/agent-skills/skill/hub-city-hall" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="372" y="26" width="238" height="100" rx="6"/>
        <circle cx="592" cy="44" r="4.5" fill="#23F2F7"/>
        <text x="491" y="64" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="17">City Hall Suite (5)</text>
        <text x="491" y="86" text-anchor="middle" fill="#CFD0C9" font-family="Inter, sans-serif" font-size="12.5">Governance &amp; Standards</text>
        <text x="491" y="108" text-anchor="middle" fill="#F7BE4F" font-family="JetBrains Mono, monospace" font-size="10.5">class: govNode · ACTIVE</text>
      </g>

      <!-- Hub 2: Visual & Brand -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="visual" data-mmd-node="hub-visual" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/hub-visual" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="372" y="145" width="238" height="100" rx="6"/>
        <text x="491" y="182" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="17">Visual &amp; Brand (6)</text>
        <text x="491" y="204" text-anchor="middle" fill="#CFD0C9" font-family="Inter, sans-serif" font-size="12.5">Tokens · SVG · Mermaid · Charts</text>
        <text x="491" y="226" text-anchor="middle" fill="#23F2F7" font-family="JetBrains Mono, monospace" font-size="10.5">class: visualNode</text>
      </g>

      <!-- Hub 3: Engineering & Media -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="eng" data-mmd-node="hub-engineering" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/hub-engineering" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="372" y="264" width="238" height="100" rx="6"/>
        <text x="491" y="302" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="17">Engineering &amp; Media (8)</text>
        <text x="491" y="324" text-anchor="middle" fill="#CFD0C9" font-family="Inter, sans-serif" font-size="12.5">Rust · Data · CLI · Media</text>
        <text x="491" y="346" text-anchor="middle" fill="#00CAE3" font-family="JetBrains Mono, monospace" font-size="10.5">class: engNode</text>
      </g>

      <!-- Hub 4: Docs & Publishing -->
      <g class="apt-mmd-node" role="button" tabindex="0" data-role="doc" data-mmd-node="hub-docs" aria-selected="false"
         hx-get="/explainer/agent-skills/skill/hub-docs" hx-target="#skills-inspector-host" hx-swap="innerHTML">
        <rect class="mmd-box" x="676" y="145" width="222" height="100" rx="6"/>
        <text x="787" y="182" text-anchor="middle" fill="#FDFDFB" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="17">Docs &amp; Sites (4)</text>
        <text x="787" y="204" text-anchor="middle" fill="#CFD0C9" font-family="Inter, sans-serif" font-size="12.5">AsciiDoc · Pandoc · Mirrors</text>
        <text x="787" y="226" text-anchor="middle" fill="#BC8F81" font-family="JetBrains Mono, monospace" font-size="10.5">class: docNode</text>
      </g>
    </svg>

