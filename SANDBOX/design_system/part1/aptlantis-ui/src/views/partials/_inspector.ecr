<div style="padding:1.15rem; display:grid; gap:1rem;">
  <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--apt-border-subtle); padding-bottom:0.75rem;">
    <div>
      <div class="apt-mono" style="font-size:0.7rem; color:var(--apt-brand-primary-hover);">NODE INSPECTOR</div>
      <h3 class="apt-mono" style="margin:0.15rem 0 0 0; font-size:0.95rem;"><%= HTML.escape(node.hostname) %></h3>
    </div>
    <button class="apt-btn" data-variant="ghost"
            onclick="document.getElementById('apt-inspector').innerHTML = ''"
            aria-label="Close Inspector">✕</button>
  </div>

  <div class="apt-panel" style="background:var(--apt-bg-base);">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; font-size:0.8rem;">
      <div>
        <div style="color:var(--apt-text-secondary); font-size:0.7rem;">CONTRACT</div>
        <div class="apt-mono"><%= HTML.escape(node.contract) %></div>
      </div>
      <div>
        <div style="color:var(--apt-text-secondary); font-size:0.7rem;">P99 LATENCY</div>
        <div class="apt-mono" style="color:var(--apt-brand-primary-hover);"><%= node.latency_ms %> ms</div>
      </div>
      <div style="grid-column:1 / -1;">
        <div style="color:var(--apt-text-secondary); font-size:0.7rem;">ATTESTATION DIGEST</div>
        <div class="apt-mono" style="word-break:break-all;"><%= node.digest %></div>
      </div>
    </div>
  </div>

  <div>
    <div style="color:var(--apt-text-secondary); font-size:0.72rem; text-transform:uppercase; font-weight:600; margin-bottom:0.35rem;">Telemetry Notes</div>
    <p style="margin:0; font-size:0.8125rem; color:var(--apt-text-primary);"><%= HTML.escape(node.notes) %></p>
  </div>

  <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
    <button class="apt-btn" data-variant="primary" style="flex:1;"
            hx-post="/nodes/<%= node.id %>/verify"
            hx-target="#apt-inspector"
            hx-swap="innerHTML">
      Verify Digest
    </button>
  </div>
</div>
