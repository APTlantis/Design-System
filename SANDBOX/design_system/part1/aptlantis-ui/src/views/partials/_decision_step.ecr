<div class="apt-decision-card" aria-live="polite">
  <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
    <span class="apt-badge" data-tone="<%= node.outcome? ? "amber" : "cyan" %>"><%= HTML.escape(node.step_tag) %></span>
    <% if node.id != "start" %>
      <button type="button"
              class="apt-btn"
              data-variant="ghost"
              hx-get="/components/decision-explorer/step/start"
              hx-target="#decision-host"
              hx-swap="innerHTML">
        ↺ Start Over
      </button>
    <% end %>
  </div>

  <div>
    <h3 class="apt-display" style="margin:0 0 0.35rem; font-size:1.2rem;"><%= HTML.escape(node.title) %></h3>
    <p style="margin:0; color:var(--apt-text-secondary);"><%= HTML.escape(node.body) %></p>
  </div>

  <% if node.outcome? %>
    <div class="apt-outcome-box">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <span class="apt-mono" style="font-size:0.74rem; color:var(--apt-brand-secondary);">RECOMMENDED PATH</span>
        <span class="apt-badge" data-tone="amber"><%= HTML.escape(node.outcome_tag.not_nil!) %></span>
      </div>
      <ul class="apt-stepper-points">
        <% node.outcome_checklist.each do |item| %>
          <li><%= HTML.escape(item) %></li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="apt-decision-choices">
      <% node.choices.each do |choice| %>
        <button type="button"
                class="apt-choice-btn"
                hx-get="/components/decision-explorer/step/<%= choice.next_id %>"
                hx-target="#decision-host"
                hx-swap="innerHTML">
          <strong class="apt-display" style="font-size:0.95rem;"><%= HTML.escape(choice.label) %> →</strong>
          <span><%= HTML.escape(choice.hint) %></span>
        </button>
      <% end %>
    </div>
  <% end %>
</div>
